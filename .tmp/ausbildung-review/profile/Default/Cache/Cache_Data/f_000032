const raw=[...messages,...signs,...schedules,...travel,...shopping,...profiles,...homeWork,...stories];
export const A1_READING_TEXTS=Object.freeze(raw.map((text,index)=>Object.freeze({
  ...text,
  difficulty:index<16?"easy":index<32?"medium":"challenge",
  questions:Object.freeze(text.questions.map((question,qIndex)=>Object.freeze({...question,id:`${text.id}-q${qIndex+1}`,type:/mainly/i.test(question.promptEn)?"main-idea":question.type==="mcq"&&qIndex===1?"information-selection":question.type})))
})));
export function validateA1ReadingBank(texts=A1_READING_TEXTS){const errors=[],ids=new Set(),questionIds=new Set();if(texts.length!==40)errors.push(`Expected 40 texts; found ${texts.length}.`);let questionCount=0;texts.forEach(text=>{if(!text.id||ids.has(text.id))errors.push(`Duplicate/missing text ID: ${text.id}`);ids.add(text.id);if(text.level!=="A1"||!A1_READING_SKILLS[text.skill]||!["easy","medium","challenge"].includes(text.difficulty)||!text.title||!text.text||!text.format)errors.push(`Invalid text metadata: ${text.id}`);if(text.questions.length<2||text.questions.length>4)errors.push(`Invalid question count: ${text.id}`);text.questions.forEach(question=>{questionCount++;if(!question.id||questionIds.has(question.id))errors.push(`Duplicate question ID: ${question.id}`);questionIds.add(question.id);if(!question.promptEn||!question.promptBn||![2,3].includes(question.options.length)||new Set(question.options).size!==question.options.length||question.answer<0||question.answer>=question.options.length||!question.explanationEn||!question.explanationBn||!question.evidence)errors.push(`Invalid question: ${question.id}`);});});if(questionCount<120)errors.push(`Expected at least 120 questions; found ${questionCount}.`);return errors;}
