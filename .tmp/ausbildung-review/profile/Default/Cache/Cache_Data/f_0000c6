.aus-language-copy>strong{font-size:.84rem;font-weight:600;line-height:1.45}
.aus-language-indicator{width:18px;height:18px;flex:0 0 18px;margin-left:5px;display:grid;place-items:center;border:1px solid #b8c7df;border-radius:50%;color:transparent}
.aus-language-buttons button[aria-pressed=true]{background:linear-gradient(120deg,#174eb5,#5141c5);color:#fff;border-color:#6477db;box-shadow:0 8px 20px #244abc30,inset 0 1px 0 #ffffff35}
.aus-language-buttons button[aria-pressed=true] .aus-language-copy>span{color:#e0e7ff}
.aus-language-buttons button[aria-pressed=true] .aus-language-monogram{color:#fff;background:#ffffff1c;border-color:#ffffff40;box-shadow:inset 0 1px 0 #ffffff30}
.aus-language-buttons button[aria-pressed=true] .aus-language-indicator{background:#fff;border-color:#fff;color:#254dab}
.aus-language-buttons button[aria-pressed=true] .aus-language-indicator:after{content:'';width:7px;height:4px;border-left:2px solid currentColor;border-bottom:2px solid currentColor;transform:translateY(-1px) rotate(-45deg)}
@media(hover:hover){.aus-language-buttons button:hover{transform:translateY(-3px);border-color:#879deb;box-shadow:0 10px 24px #244abc22}}
.aus-language-buttons button:active{transform:translateY(0)}
.aus-language-buttons button:focus-visible{outline:3px solid #60a5fa;outline-offset:4px}
.ausbildung-body.dark .aus-language-bar,.ausbildung-body.dark-mode .aus-language-bar{--language-ink:#edf3ff;--language-muted:#b4c4dd;--language-card:linear-gradient(145deg,#1b2c47,#152239);--language-border:#344763;background:linear-gradient(115deg,#142239,#101b30);border-color:#2c3c57;box-shadow:0 8px 32px #00000015,inset 0 1px 0 #ffffff08}
.ausbildung-body.dark .aus-language-monogram,.ausbildung-body.dark-mode .aus-language-monogram{background:linear-gradient(145deg,#263d65,#302c59);color:#bfdbfe;border-color:#4c6085;box-shadow:inset 0 1px 0 #ffffff10}
.ausbildung-body .aus-hero h1{overflow-wrap:anywhere}
.ausbildung-body .aus-tools button{white-space:normal}
html[lang=bn] .ausbildung-body{font-family:"Nirmala UI","Bangla Sangam MN","Vrinda",sans-serif}
html[lang=bn] .aus-page p,html[lang=bn] .aus-page li,html[lang=bn] .aus-page dd,html[lang=bn] .aus-checklist label{font-size:1rem;line-height:1.95}
html[lang=bn] .aus-page table{font-size:.94rem;line-height:1.9}
html[lang=bn] .aus-page th,html[lang=bn] .aus-page td{min-width:160px}
html[lang=bn] .aus-hero h1{font-size:clamp(2.1rem,4.5vw,4rem);line-height:1.25;letter-spacing:0}
html[lang=bn] .aus-eyebrow{letter-spacing:.03em;font-size:.82rem}
html[lang=bn] .aus-scroll-top{font-family:inherit}
@media(max-width:1100px){.aus-language-bar{flex-wrap:wrap;gap:12px}.aus-language-buttons{width:100%;display:grid;grid-template-columns:repeat(3,minmax(0,1fr))}.aus-language-buttons button{min-width:0}.aus-language-indicator{margin-left:auto}}
@media(max-width:900px){.aus-language-bar{width:calc(100% - 32px)}}
@media(max-width:600px){
  .aus-language-bar{width:calc(100% - 24px);padding:14px;gap:10px;margin-top:14px}
  .aus-language-buttons{width:100%;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
  .aus-language-buttons button{min-width:0;min-height:126px;padding:14px 12px;flex-direction:column;align-items:flex-start;gap:10px;overflow-wrap:anywhere}
  .aus-language-buttons .aus-language-indicator{position:absolute;right:12px;top:14px;margin:0}
  .aus-language-copy>strong{font-size:.8rem}
  .aus-language-copy>span{font-size:.65rem}
  .aus-language-buttons .aus-language-english{grid-column:1/-1;flex-direction:row;align-items:center;min-height:58px;padding:10px 14px}
  .aus-language-english .aus-language-monogram{flex-basis:32px;width:32px;height:32px;border-radius:10px}
  .aus-language-english .aus-language-copy{flex:1;flex-direction:row;align-items:center;justify-content:space-between;gap:12px}
  .aus-language-english .aus-language-indicator{position:static}
  html[lang=bn] .aus-page p,html[lang=bn] .aus-page li{font-size:.98rem}
  html[lang=bn] .aus-page table{font-size:.9rem}
}
html:has(.ausbildung-body)::view-transition-old(root),html:has(.ausbildung-body)::view-transition-new(root){animation-duration:180ms;animation-timing-function:ease-out}
@media print{.aus-language-bar{display:none!important}}
