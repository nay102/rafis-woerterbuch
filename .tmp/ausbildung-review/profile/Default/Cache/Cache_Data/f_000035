const splitTurn = (raw, nodeIndex, prefix) => {
  const [partner, bestRaw, acceptable, unsuitable] = raw.split("|");
  const best = bestRaw.split("~");
  const next = `n${nodeIndex + 2}`;
  return Object.freeze({id:`n${nodeIndex + 1}`,partner,responses:Object.freeze([
    ...best.map((text, i) => Object.freeze({id:`${prefix}-n${nodeIndex+1}-best-${i+1}`,text,quality:"best",next})),
    Object.freeze({id:`${prefix}-n${nodeIndex+1}-acceptable`,text:acceptable,quality:"acceptable",next}),
    Object.freeze({id:`${prefix}-n${nodeIndex+1}-unsuitable`,text:unsuitable,quality:"not-suitable",retry:true})
  ])});
};

let order = 0;
export const A1_DIALOGUES = Object.freeze(Object.entries(banks).flatMap(([skill, rows]) => rows.map((row, dialogueIndex) => {
  order++;
  const [title,situationEn,learnerGoalEn,partnerRole,rawTurns] = row;
  const id=`a1-dialogue-${skill}-${String(dialogueIndex+1).padStart(3,"0")}`,nodes = rawTurns.map((raw, i) => splitTurn(raw, i, id));
  return Object.freeze({id,level:"A1",type:"communication",skill,difficulty:order<=16?"easy":order<=32?"medium":"challenge",title,situationEn,situationBn:"এটি একটি দৈনন্দিন German conversation। পরিস্থিতি বুঝে natural response বাছাই করুন।",learnerGoalEn,partnerRole,usefulWords:Object.freeze([...new Set(nodes.flatMap(node=>node.responses.filter(r=>r.quality==="best").flatMap(r=>r.text.split(/\s+/).filter(word=>word.length>4))).slice(0,4))]),relatedTopic:A1_DIALOGUE_SKILLS[skill].topic,startNode:"n1",nodes:Object.freeze(nodes)});
})));

export function validateA1DialogueBank(dialogues=A1_DIALOGUES){
  const errors=[],ids=new Set(),globalResponseIds=new Set(); if(dialogues.length!==40)errors.push(`Expected 40 dialogues; found ${dialogues.length}.`);
  dialogues.forEach(dialogue=>{if(!dialogue.id||ids.has(dialogue.id))errors.push(`Duplicate ID: ${dialogue.id}`);ids.add(dialogue.id);if(dialogue.level!=="A1"||!A1_DIALOGUE_SKILLS[dialogue.skill]||!["easy","medium","challenge"].includes(dialogue.difficulty)||!dialogue.title||!dialogue.situationEn||!dialogue.learnerGoalEn||!dialogue.partnerRole||!dialogue.relatedTopic)errors.push(`Invalid metadata: ${dialogue.id}`);if(dialogue.nodes.length<3||dialogue.nodes.length>5)errors.push(`Invalid turn count: ${dialogue.id}`);const nodeIds=new Set(dialogue.nodes.map(node=>node.id));if(!nodeIds.has(dialogue.startNode))errors.push(`Missing start node: ${dialogue.id}`);dialogue.nodes.forEach((node,index)=>{if(!node.partner||node.responses.length<3||!node.responses.some(r=>r.quality==="best")||!node.responses.some(r=>r.quality==="acceptable")||!node.responses.some(r=>r.quality==="not-suitable"))errors.push(`Invalid node: ${dialogue.id}/${node.id}`);const responseIds=new Set();node.responses.forEach(response=>{if(!response.id||responseIds.has(response.id)||globalResponseIds.has(response.id)||!response.text)errors.push(`Invalid response: ${dialogue.id}/${node.id}`);responseIds.add(response.id);globalResponseIds.add(response.id);if(response.quality==="not-suitable"&&!response.retry)errors.push(`Unsuitable response must retry: ${dialogue.id}/${node.id}`);if(response.next&&index<dialogue.nodes.length-1&&!nodeIds.has(response.next))errors.push(`Broken branch: ${dialogue.id}/${node.id}`);if(response.next&&Number(response.next.slice(1))<=index+1)errors.push(`Non-forward branch: ${dialogue.id}/${node.id}`);if(index===dialogue.nodes.length-1&&response.quality!=="not-suitable"&&response.next!==`n${index+2}`)errors.push(`Invalid terminal: ${dialogue.id}/${node.id}`);});});});
  Object.keys(A1_DIALOGUE_SKILLS).forEach(skill=>{if(dialogues.filter(d=>d.skill===skill).length!==5)errors.push(`Wrong ${skill} count.`);});
  Object.entries({easy:16,medium:16,challenge:8}).forEach(([difficulty,count])=>{if(dialogues.filter(d=>d.difficulty===difficulty).length!==count)errors.push(`Wrong ${difficulty} count.`);}); return errors;
}
